# Root of the marketing workspace the commands operate on.
# Unset, every command uses the bundled example workspace of the checkout.
AGENTIC_MARKETING_WORKSPACE=/path/to/your/marketing-workspace

# Upper bound for a context pack, in tokens. Building stops above it.
AGENTIC_MARKETING_PACK_BUDGET=12000

# Seconds before a source fetch is given up on.
AGENTIC_MARKETING_FETCH_TIMEOUT=20

# Contact address sent as User-Agent when fetching sources.
AGENTIC_MARKETING_CONTACT=you@example.com

# Model used by the second verification pass.
AGENTIC_MARKETING_JUDGE_MODEL=claude-sonnet-4-5

# Needed only for the second verification pass.
ANTHROPIC_API_KEY=

# Cockpit database (Supabase). The service key is for the scheduled jobs only and never
# reaches the app or a page.
AGENTIC_MARKETING_SUPABASE_URL=https://<project-ref>.supabase.co
AGENTIC_MARKETING_SUPABASE_SERVICE_KEY=

# Public key the blog pages use to report hits. It may only call the hit function.
AGENTIC_MARKETING_SUPABASE_ANON_KEY=

# Token allowed to push to the repositories of the blog targets.
AGENTIC_MARKETING_GITHUB_TOKEN=

# Where the publishing targets are described; the templates live beside it in templates/.
AGENTIC_MARKETING_TARGETS_FILE=config/targets.yaml
